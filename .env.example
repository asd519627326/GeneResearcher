# Required for NCBI Entrez requests
ENTREZ_EMAIL=you@example.org

# DashScope embedding service
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL_NAME=text-embedding-v3
EMBEDDING_API_KEY=replace-me

# OpenAI-compatible language-model API
LLM_MODEL_NAME=replace-me
LLM_API_KEY=replace-me
LLM_BASE_URL=https://your-llm-endpoint.example/v1

# Optional comma-separated PMID exclusions
EXCLUDE_PMIDS=
